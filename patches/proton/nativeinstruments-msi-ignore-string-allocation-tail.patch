From: Kitsune <kitsune@akitsune.dev>
Date: Sun, 30 Aug 2026 22:00:00 -0400
Subject: [PATCH] msi: Exclude allocation tail from serialized string table

Keep the initialized string-table extent separate from its dynamically grown
allocation.  Using allocation capacity to serialize _StringPool can retain a
large unused tail and spuriously select three-byte string references once the
capacity crosses 65535 entries.

diff --git a/dlls/msi/string.c b/dlls/msi/string.c
index 38381b8b521..b7533d231a7 100644
--- a/dlls/msi/string.c
+++ b/dlls/msi/string.c
@@ -50,7 +50,8 @@ struct msistring
 
 struct string_table
 {
-    UINT maxcount;         /* the number of strings */
+    UINT count;            /* number of initialized string slots */
+    UINT maxcount;         /* number of allocated string slots */
     UINT freeslot;
     UINT codepage;
     UINT sortcount;
@@ -96,6 +97,7 @@ static string_table *init_stringtable( int entries, UINT codepage )
         return NULL;
     }
 
+    st->count = entries;
     st->maxcount = entries;
     st->freeslot = 1;
     st->codepage = codepage;
@@ -221,6 +223,7 @@ static void set_st_entry( string_table *st, UINT n, WCHAR *str, int len, USHORT
 
     st->strings[n].data = str;
     st->strings[n].len  = len;
+    if (n >= st->count) st->count = n + 1;
 
     insert_string_sorted( st, n );
 
@@ -421,7 +424,7 @@ UINT msi_string2id( const string_table *st, const WCHAR *str, int len, UINT *id
     return ERROR_INVALID_PARAMETER;
 }
 
-static void string_totalsize( const string_table *st, UINT *datasize, UINT *poolsize )
+static void string_totalsize( const string_table *st, UINT count, UINT *datasize, UINT *poolsize )
 {
     UINT i, len, holesize;
 
@@ -431,7 +434,7 @@ static void string_totalsize( const string_table *st, UINT *datasize, UINT *pool
     *poolsize = 4;
     *datasize = 0;
     holesize = 0;
-    for( i=1; i<st->maxcount; i++ )
+    for( i=1; i<count; i++ )
     {
         if( !st->strings[i].persistent_refcount )
         {
@@ -563,7 +566,7 @@ end:
 
 UINT msi_save_string_table( const string_table *st, IStorage *storage, UINT *bytes_per_strref )
 {
-    UINT i, datasize = 0, poolsize = 0, sz, used, r, codepage, n;
+    UINT i, count, datasize = 0, poolsize = 0, sz, used, r, codepage, n;
     UINT ret = ERROR_FUNCTION_FAILED;
     CHAR *data = NULL;
     USHORT *pool = NULL;
@@ -571,9 +574,10 @@ UINT msi_save_string_table( const string_table *st, IStorage *storage, UINT *byt
     TRACE("\n");
 
     /* construct the new table in memory first */
-    string_totalsize( st, &datasize, &poolsize );
+    count = st->count;
+    string_totalsize( st, count, &datasize, &poolsize );
 
-    TRACE("%u %u %u\n", st->maxcount, datasize, poolsize );
+    TRACE("%u %u %u\n", count, datasize, poolsize );
 
     pool = malloc( poolsize );
     if( ! pool )
@@ -592,7 +596,7 @@ UINT msi_save_string_table( const string_table *st, IStorage *storage, UINT *byt
     codepage = st->codepage;
     pool[0] = codepage & 0xffff;
     pool[1] = codepage >> 16;
-    if (st->maxcount > 0xffff)
+    if (count > 0x10000)
     {
         pool[1] |= 0x8000;
         *bytes_per_strref = LONG_STR_BYTES;
@@ -601,7 +605,7 @@ UINT msi_save_string_table( const string_table *st, IStorage *storage, UINT *byt
         *bytes_per_strref = sizeof(USHORT);
 
     n = 1;
-    for( i=1; i<st->maxcount; i++ )
+    for( i=1; i<count; i++ )
     {
         if( !st->strings[i].persistent_refcount )
         {
diff --git a/dlls/msi/tests/db.c b/dlls/msi/tests/db.c
index 56fff94c5df..5439b8672a0 100644
--- a/dlls/msi/tests/db.c
+++ b/dlls/msi/tests/db.c
@@ -5723,6 +5723,7 @@ static void test_stringtable(void)
 
     hr = IStream_Read(stm, data, MAX_PATH, &read);
     ok(hr == S_OK, "Expected S_OK, got %#lx\n", hr);
+    ok(read <= sizeof(data13), "String pool contains unused allocation slots\n");
     todo_wine
     {
         ok(read == 64, "Expected 64, got %lu\n", read);
-- 
2.51.0

